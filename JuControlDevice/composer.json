{
    "name": "jucontrol/connector",
    "description": "Modern IP-Symcon module for Judo water softening devices",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "tlowcode/bumaas",
            "email": "info@example.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "JuControlDevice\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JuControlDevice\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "stan": "phpstan analyse src --level=8"
    },
    "config": {
        "sort-packages": true
    }
}